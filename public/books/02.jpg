<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 850" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3a8a"/>
      <stop offset="45%" stop-color="#172554"/>
      <stop offset="80%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="goldTech" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="50%" stop-color="#facc15"/>
      <stop offset="100%" stop-color="#ca8a04"/>
    </linearGradient>
    <filter id="shadow2" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="2" dy="3" stdDeviation="4" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="600" height="850" fill="url(#bgGrad2)"/>
  
  <!-- Spine Shadow -->
  <rect x="0" y="0" width="30" height="850" fill="#000000" opacity="0.4"/>
  <rect x="30" y="0" width="3" height="850" fill="#ffffff" opacity="0.15"/>

  <!-- Top Syllabus Badge & Header -->
  <rect x="30" y="24" width="540" height="48" rx="6" fill="#0f172a" opacity="0.9"/>
  <rect x="30" y="24" width="540" height="48" rx="6" fill="none" stroke="#60a5fa" stroke-width="1.2" opacity="0.6"/>
  <text x="50" y="44" font-family="system-ui, sans-serif" font-size="11" font-weight="800" fill="#93c5fd" letter-spacing="0.8">AS PER PCI SYLLABUS • FIRST EDITION (MAY 2022)</text>
  <text x="50" y="60" font-family="system-ui, sans-serif" font-size="10" font-weight="600" fill="#bfdbfe">B-Pharmacy (Semester-VI / VII) • Technical Publications</text>

  <!-- Publisher Logo Box -->
  <rect x="440" y="30" width="116" height="34" rx="4" fill="#2563eb"/>
  <text x="498" y="45" font-family="system-ui, sans-serif" font-size="9" font-weight="900" fill="#ffffff" text-anchor="middle">TECHNICAL</text>
  <text x="498" y="57" font-family="system-ui, sans-serif" font-size="8" font-weight="700" fill="#fde047" text-anchor="middle">PUBLICATIONS</text>

  <!-- Main Title Section -->
  <g transform="translate(50, 105)">
    <text x="0" y="36" font-family="system-ui, sans-serif" font-size="16" font-weight="700" fill="#facc15" letter-spacing="1.5">
      PHARMACEUTICAL SCIENCES TEXTBOOK
    </text>
    <text x="0" y="84" font-family="system-ui, sans-serif" font-size="38" font-weight="900" fill="#ffffff" filter="url(#shadow2)" letter-spacing="-0.5">
      BIOPHARMACEUTICS
    </text>
    <text x="0" y="132" font-family="system-ui, sans-serif" font-size="34" font-weight="900" fill="url(#goldTech)" filter="url(#shadow2)">
      &amp; Pharmacokinetics
    </text>
    <rect x="0" y="152" width="380" height="3" fill="#3b82f6"/>
    <text x="0" y="180" font-family="system-ui, sans-serif" font-size="12" font-weight="500" fill="#93c5fd">
      Drug Absorption • Disposition • ADME • Compartment Modeling • Bioequivalence
    </text>
  </g>

  <!-- Central Scientific PK Chart Area -->
  <g transform="translate(55, 325)">
    <rect x="0" y="0" width="490" height="245" rx="14" fill="#0f172a" opacity="0.85" stroke="#3b82f6" stroke-width="1.2"/>
    
    <!-- Pharmacokinetic Curve Graph Window -->
    <g transform="translate(30, 25)">
      <!-- Axes -->
      <line x1="40" y1="170" x2="420" y2="170" stroke="#64748b" stroke-width="1.5"/>
      <line x1="40" y1="20" x2="40" y2="170" stroke="#64748b" stroke-width="1.5"/>
      <text x="420" y="185" font-family="system-ui, sans-serif" font-size="10" fill="#94a3b8" text-anchor="end">Time (hours) →</text>
      <text x="30" y="15" font-family="system-ui, sans-serif" font-size="10" fill="#94a3b8">Plasma Drug Concentration (Cp) ↑</text>

      <!-- Therapeutic Window Bands -->
      <line x1="40" y1="60" x2="400" y2="60" stroke="#ef4444" stroke-width="1" stroke-dasharray="4"/>
      <text x="320" y="55" font-family="system-ui, sans-serif" font-size="9" fill="#fca5a5">MTC (Minimum Toxic Conc.)</text>
      
      <line x1="40" y1="130" x2="400" y2="130" stroke="#22c55e" stroke-width="1" stroke-dasharray="4"/>
      <text x="320" y="125" font-family="system-ui, sans-serif" font-size="9" fill="#86efac">MEC (Minimum Effective Conc.)</text>

      <!-- PK Plasma Concentration vs Time Curve 1 (Oral Tablet) -->
      <path d="M 40,170 C 70,30 110,40 180,95 C 240,140 320,165 390,168" fill="none" stroke="#f59e0b" stroke-width="3.5"/>
      <!-- PK Plasma Curve 2 (IV Bolus) -->
      <path d="M 40,35 C 90,85 160,135 250,158 C 310,166 360,169 390,170" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="5 3"/>

      <!-- Cmax & Tmax Marker -->
      <circle cx="95" cy="40" r="5" fill="#f59e0b"/>
      <text x="105" y="38" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" fill="#fde047">Cmax (Peak Conc.)</text>
      <line x1="95" y1="40" x2="95" y2="170" stroke="#f59e0b" stroke-width="1" stroke-dasharray="2"/>
      <text x="95" y="185" font-family="system-ui, sans-serif" font-size="9" fill="#fde047" text-anchor="middle">tmax</text>
    </g>
  </g>

  <!-- Authors Block -->
  <g transform="translate(50, 600)">
    <rect x="0" y="0" width="500" height="105" rx="10" fill="#0f172a" opacity="0.7" stroke="#3b82f6" stroke-width="0.8" stroke-opacity="0.4"/>
    <text x="20" y="24" font-family="system-ui, sans-serif" font-size="10" font-weight="800" fill="#93c5fd" letter-spacing="1">AUTHORS</text>
    
    <g transform="translate(20, 36)" font-family="system-ui, sans-serif" font-size="13" font-weight="700" fill="#ffffff">
      <text x="0" y="20">Vipul A. Sansare</text>
      <text x="170" y="20" font-weight="800" fill="#facc15">Tushar G. Rukari</text>
      <text x="340" y="20">Prashant P. Mane</text>
    </g>
    <text x="20" y="85" font-family="system-ui, sans-serif" font-size="10" font-weight="500" fill="#94a3b8">
      Faculty of Pharmacy • Department of Pharmaceutics
    </text>
  </g>

  <!-- Footer Section -->
  <g transform="translate(50, 740)">
    <line x1="0" y1="0" x2="500" y2="0" stroke="#3b82f6" stroke-width="1.2" opacity="0.6"/>
    <text x="0" y="24" font-family="system-ui, sans-serif" font-size="14" font-weight="800" fill="#ffffff">
      TECHNICAL PUBLICATIONS
    </text>
    <text x="0" y="40" font-family="system-ui, sans-serif" font-size="11" font-weight="500" fill="#93c5fd">
      Pune, India • Pioneering Technical &amp; Pharmacy Education
    </text>

    <rect x="360" y="8" width="140" height="38" rx="6" fill="#0f172a" stroke="#3b82f6" stroke-width="1"/>
    <text x="370" y="24" font-family="monospace" font-size="9" fill="#93c5fd">ISBN 978-81-9479-932-0</text>
    <text x="370" y="38" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#38bdf8">● B-PHARM PCI EDITION</text>
  </g>
</svg>
